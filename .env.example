# Frontend (Vite build-time)
VITE_BASE_PATH=/pokemon-battle-draft-v2/
# Leave empty to use the serverless PeerJS relay; set to use the dedicated backend.
VITE_BACKEND_URL=ws://127.0.0.1:8787
# Backend
PORT=8787
# Comma-separated list of allowed browser origins (empty = allow any).
ALLOWED_ORIGIN=http://127.0.0.1:5173
ROOM_TTL_MINUTES=45
MAX_ROOMS=5000
# In-app battles: seconds per decision and for Team Preview (the default move is played on timeout).
BATTLE_DECISION_SECONDS=150
BATTLE_PREVIEW_SECONDS=90
